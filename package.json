{
  "name": "stuadio",
  "version": "1.0.1",
  "description": "Studio sound from any recording.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "enhance": "node scripts/cli.js",
    "test": "node scripts/selftest.js",
    "icons": "node scripts/make-icons.js",
    "icons:ui": "node scripts/build-icons.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "author": "Stuadio",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.71.0",
    "sharp": "^0.35.5"
  },
  "productName": "Stuadio",
  "private": true,
  "build": {
    "appId": "com.stuadio.app",
    "productName": "Stuadio",
    "copyright": "Copyright © 2026 Stuadio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "cb.rnnn"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Stuadio",
      "artifactName": "Stuadio-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bertrand-Ir",
        "repo": "Stuadio",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bertrand-Ir/Stuadio.git"
  }
}
